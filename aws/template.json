{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "WorshipCue isolated AWS development workspace. Managed identity, transactional storage, private immutable files, realtime hints.",
  "Parameters": {
    "CodeBucket": {
      "Type": "String"
    },
    "CodeKey": {
      "Type": "String"
    },
    "SenderIdentityArn": {
      "Type": "String",
      "Default": "",
      "NoEcho": true
    },
    "SenderAddress": {
      "Type": "String",
      "Default": "",
      "NoEcho": true
    }
  },
  "Conditions": {
    "HasSender": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "SenderIdentityArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "Table": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "PK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "PK",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "TimeToLiveSpecification": {
          "AttributeName": "expires_at_epoch",
          "Enabled": true
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "WorshipCue"
          },
          {
            "Key": "Environment",
            "Value": "Development"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Assets": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "WorshipCue"
          },
          {
            "Key": "Environment",
            "Value": "Development"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AssetsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Assets"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "HTTPSOnly",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Assets",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Assets.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "RequireImmutableCreates",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${Assets.Arn}/*"
              },
              "Condition": {
                "Null": {
                  "s3:if-none-match": "true"
                },
                "Bool": {
                  "s3:ObjectCreationOperation": "true"
                }
              }
            }
          ]
        }
      }
    },
    "Backups": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "WorshipCue"
          },
          {
            "Key": "Environment",
            "Value": "Development"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "BackupsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Backups"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "HTTPSOnly",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Backups",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Backups.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "${AWS::StackName}"
        },
        "UserPoolTier": "ESSENTIALS",
        "UsernameConfiguration": {
          "CaseSensitive": false
        },
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "MfaConfiguration": "OFF",
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 24,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true
          },
          "SignInPolicy": {
            "AllowedFirstAuthFactors": {
              "Fn::If": [
                "HasSender",
                [
                  "PASSWORD",
                  "EMAIL_OTP"
                ],
                [
                  "PASSWORD"
                ]
              ]
            }
          }
        },
        "EmailConfiguration": {
          "Fn::If": [
            "HasSender",
            {
              "EmailSendingAccount": "DEVELOPER",
              "SourceArn": {
                "Ref": "SenderIdentityArn"
              },
              "From": {
                "Ref": "SenderAddress"
              }
            },
            {
              "EmailSendingAccount": "COGNITO_DEFAULT"
            }
          ]
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "admin_only",
              "Priority": 1
            }
          ]
        },
        "Schema": [
          {
            "Name": "email",
            "AttributeDataType": "String",
            "Mutable": true,
            "Required": false
          },
          {
            "Name": "is_guest",
            "AttributeDataType": "String",
            "Mutable": false,
            "Required": false,
            "StringAttributeConstraints": {
              "MinLength": "4",
              "MaxLength": "5"
            }
          }
        ],
        "UserPoolTags": {
          "Application": "WorshipCue",
          "Environment": "Development"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Client": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "ClientName": {
          "Fn::Sub": "${AWS::StackName}-ipad"
        },
        "GenerateSecret": false,
        "ExplicitAuthFlows": [
          "ALLOW_USER_AUTH",
          "ALLOW_ADMIN_USER_PASSWORD_AUTH",
          "ALLOW_REFRESH_TOKEN_AUTH"
        ],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "RefreshTokenRotation": {
          "Feature": "DISABLED"
        },
        "AuthSessionValidity": 10,
        "AccessTokenValidity": 1,
        "IdTokenValidity": 1,
        "RefreshTokenValidity": 30,
        "TokenValidityUnits": {
          "AccessToken": "hours",
          "IdToken": "hours",
          "RefreshToken": "days"
        },
        "ReadAttributes": [
          "email",
          "email_verified",
          "custom:is_guest"
        ],
        "WriteAttributes": [
          "email"
        ]
      }
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-http"
        },
        "ProtocolType": "HTTP"
      }
    },
    "SocketApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-realtime"
        },
        "ProtocolType": "WEBSOCKET",
        "RouteSelectionExpression": "$request.body.action"
      }
    },
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-backend"
        },
        "RetentionInDays": 14
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "Workspace",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "LogGroup",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem",
                    "dynamodb:Query",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Table",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Assets.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cognito-idp:AdminCreateUser",
                    "cognito-idp:AdminSetUserPassword",
                    "cognito-idp:AdminInitiateAuth",
                    "cognito-idp:AdminDeleteUser"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "UserPool",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "execute-api:ManageConnections",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${SocketApi}/development/POST/@connections/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Backend": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-backend"
        },
        "Runtime": "python3.13",
        "Handler": "handler.lambda_handler",
        "Architectures": [
          "arm64"
        ],
        "Role": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "Timeout": 60,
        "MemorySize": 1024,
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "Table"
            },
            "ASSET_BUCKET": {
              "Ref": "Assets"
            },
            "USER_POOL_ID": {
              "Ref": "UserPool"
            },
            "CLIENT_ID": {
              "Ref": "Client"
            },
            "EMAIL_READY": {
              "Fn::If": [
                "HasSender",
                "true",
                "false"
              ]
            },
            "WEBSOCKET_MANAGEMENT_URL": {
              "Fn::Sub": "https://${SocketApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}/development"
            }
          }
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "WorshipCue"
          },
          {
            "Key": "Environment",
            "Value": "Development"
          }
        ]
      },
      "DependsOn": [
        "LogGroup"
      ]
    },
    "BackupLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-backup"
        },
        "RetentionInDays": 14
      }
    },
    "BackupRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "BackupOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "BackupLogGroup",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:CreateBackup",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Table",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:DescribeBackup",
                  "Resource": {
                    "Fn::Sub": "${Table.Arn}/backup/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketVersioning"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "Assets",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::GetAtt": [
                        "Backups",
                        "Arn"
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${Assets.Arn}/*"
                    },
                    {
                      "Fn::Sub": "${Backups.Arn}/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": {
                    "Fn::Sub": "${Backups.Arn}/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "BackupFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-backup"
        },
        "Runtime": "python3.13",
        "Handler": "backup.lambda_handler",
        "Architectures": [
          "arm64"
        ],
        "Role": {
          "Fn::GetAtt": [
            "BackupRole",
            "Arn"
          ]
        },
        "Timeout": 900,
        "MemorySize": 1024,
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "Table"
            },
            "ASSET_BUCKET": {
              "Ref": "Assets"
            },
            "BACKUP_BUCKET": {
              "Ref": "Backups"
            }
          }
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "WorshipCue"
          },
          {
            "Key": "Environment",
            "Value": "Development"
          }
        ]
      },
      "DependsOn": [
        "BackupLogGroup"
      ]
    },
    "BackupSchedule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "Independent daily metadata and immutable-file backup",
        "ScheduleExpression": "cron(0 4 * * ? *)",
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "BackupFunction",
                "Arn"
              ]
            },
            "Id": "DailyBackup",
            "RetryPolicy": {
              "MaximumEventAgeInSeconds": 3600,
              "MaximumRetryAttempts": 2
            }
          }
        ]
      }
    },
    "BackupSchedulePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "BackupFunction"
        },
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "BackupSchedule",
            "Arn"
          ]
        }
      }
    },
    "HttpIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "Backend",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 30000
      }
    },
    "SocketIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "SocketApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationMethod": "POST",
        "IntegrationUri": {
          "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${Backend.Arn}/invocations"
        }
      }
    },
    "Authorizer": {
      "Type": "AWS::ApiGatewayV2::Authorizer",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "AuthorizerType": "JWT",
        "Name": "CognitoAccess",
        "IdentitySource": [
          "$request.header.Authorization"
        ],
        "JwtConfiguration": {
          "Audience": [
            {
              "Ref": "Client"
            }
          ],
          "Issuer": {
            "Fn::Sub": "https://cognito-idp.${AWS::Region}.${AWS::URLSuffix}/${UserPool}"
          }
        }
      }
    },
    "HealthRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "GET /health",
        "Target": {
          "Fn::Sub": "integrations/${HttpIntegration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "AuthRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /auth/{proxy+}",
        "Target": {
          "Fn::Sub": "integrations/${HttpIntegration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "RestRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "ANY /rest/{proxy+}",
        "Target": {
          "Fn::Sub": "integrations/${HttpIntegration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "Authorizer"
        },
        "AuthorizationScopes": [
          "aws.cognito.signin.user.admin"
        ]
      }
    },
    "FunctionsRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "RouteKey": "POST /functions/{proxy+}",
        "Target": {
          "Fn::Sub": "integrations/${HttpIntegration}"
        },
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "Authorizer"
        },
        "AuthorizationScopes": [
          "aws.cognito.signin.user.admin"
        ]
      }
    },
    "ConnectRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "SocketApi"
        },
        "RouteKey": "$connect",
        "Target": {
          "Fn::Sub": "integrations/${SocketIntegration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "DisconnectRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "SocketApi"
        },
        "RouteKey": "$disconnect",
        "Target": {
          "Fn::Sub": "integrations/${SocketIntegration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "DefaultRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "SocketApi"
        },
        "RouteKey": "$default",
        "Target": {
          "Fn::Sub": "integrations/${SocketIntegration}"
        },
        "AuthorizationType": "NONE"
      }
    },
    "HttpStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "HttpApi"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 30,
          "ThrottlingRateLimit": 10
        }
      }
    },
    "SocketStage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "SocketApi"
        },
        "StageName": "development",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "DataTraceEnabled": false,
          "LoggingLevel": "OFF",
          "ThrottlingBurstLimit": 50,
          "ThrottlingRateLimit": 20
        }
      }
    },
    "HttpPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Backend"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${HttpApi}/*/*"
        }
      }
    },
    "SocketPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Backend"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${SocketApi}/*/*"
        }
      }
    }
  },
  "Outputs": {
    "APIURL": {
      "Value": {
        "Fn::Sub": "https://${HttpApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}"
      }
    },
    "WebSocketURL": {
      "Value": {
        "Fn::Sub": "wss://${SocketApi}.execute-api.${AWS::Region}.${AWS::URLSuffix}/development"
      }
    },
    "UserPoolId": {
      "Value": {
        "Ref": "UserPool"
      }
    },
    "ClientId": {
      "Value": {
        "Ref": "Client"
      }
    },
    "TableName": {
      "Value": {
        "Ref": "Table"
      }
    },
    "AssetBucket": {
      "Value": {
        "Ref": "Assets"
      }
    },
    "BackupBucket": {
      "Value": {
        "Ref": "Backups"
      }
    },
    "BackendFunction": {
      "Value": {
        "Ref": "Backend"
      }
    },
    "EmailOTPReady": {
      "Value": {
        "Fn::If": [
          "HasSender",
          "true",
          "false"
        ]
      }
    },
    "BackupFunction": {
      "Value": {
        "Ref": "BackupFunction"
      }
    }
  }
}
