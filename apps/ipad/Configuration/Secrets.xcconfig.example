// Copy to Secrets.xcconfig in this folder after an authorized Supabase project is ready.
// The $() prevents Xcode treating // in the URL as a comment.
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_REPLACE_ME
// Never place a service-role/secret key, password or refresh token in this file.
