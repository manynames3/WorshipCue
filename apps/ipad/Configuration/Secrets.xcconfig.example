// Copy to ignored Secrets.xcconfig after an authorized development deployment.
// The $() prevents Xcode treating // in the URL as a comment.
REMOTE_PROVIDER = aws
AWS_API_URL =
AWS_WEBSOCKET_URL =
// The preserved adapter can use REMOTE_PROVIDER = supabase with public settings.
SUPABASE_URL =
SUPABASE_PUBLISHABLE_KEY =
// Never include AWS credentials, service keys, passwords, refresh tokens or sender addresses.
