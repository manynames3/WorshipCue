{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Published immutable chart version",
  "type": "object",
  "required": [
    "schema_version",
    "chart_version_id",
    "church_id",
    "song_id",
    "version_number",
    "label",
    "written_key",
    "pdf_asset_id",
    "pdf_sha256",
    "pdf_bytes",
    "page_count",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "chart_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "church_id": {
      "type": "string",
      "format": "uuid"
    },
    "song_id": {
      "type": "string",
      "format": "uuid"
    },
    "version_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "label": {
      "type": "string",
      "maxLength": 120
    },
    "written_key": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-G](#|b)?m?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pdf_asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pdf_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "page_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "crop_x",
          "crop_y",
          "crop_width",
          "crop_height",
          "rotation"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "crop_x": {
            "type": "number"
          },
          "crop_y": {
            "type": "number"
          },
          "crop_width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "crop_height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rotation": {
            "enum": [
              0,
              90,
              180,
              270
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "description": "Additional server validation: page_count equals pages.length, asset is verified/owned, tenant/song references match."
}
